# ─────────────────────────────────────────────────────────────────────────────
# RAG Document Chatbot – environment variables
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="RAG Document Chatbot"
APP_VERSION="0.1.0"
DEBUG=false

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AWS ───────────────────────────────────────────────────────────────────────
# DO NOT hardcode credentials here.
# Use IAM roles (EC2 instance profile) in production, or export these in your
# shell / CI environment from a secrets manager.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Amazon Bedrock ────────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=documents

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Document processing ───────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_UPLOAD_MB=50

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
